# Copy this file to .env on the VPS and replace every value before starting Compose.
PUBLIC_DEMO_DOMAIN=demo.example.com
FRONTEND_ORIGIN=https://demo.example.com
POSTGRES_PASSWORD=REPLACE_WITH_A_UNIQUE_RANDOM_SECRET
JWT_SECRET=REPLACE_WITH_BASE64_ENCODED_RANDOM_SECRET_AT_LEAST_32_BYTES
BILLING_INTERNAL_SERVICE_TOKEN=REPLACE_WITH_A_UNIQUE_RANDOM_SECRET
DEMO_ADMIN_EMAIL=owner@example.com
DEMO_ADMIN_PASSWORD=REPLACE_WITH_A_PRIVATE_RANDOM_PASSWORD_24_TO_72_UTF8_BYTES
AI_DEMO_MONITORING_ENABLED=false
DEMO_DOCTORS_ENABLED=true
DEMO_LAB_TESTS_ENABLED=true
